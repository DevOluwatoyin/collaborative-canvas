# Flat node_modules. Some transitive deps in the canvas stack resolve at runtime
# in ways that break under pnpm's default symlinked layout; removing this shows up
# as module-resolution errors in the browser, not at install time.
node-linker=hoisted

# y-websocket / y-protocols declare their peers loosely. Auto-installing keeps the
# web app and the collab server on one Yjs instance, which the sync protocol needs.
auto-install-peers=true
